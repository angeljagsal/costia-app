# Copy to .env and fill in. Never commit .env.
# Supabase project (Auth + Postgres). Create at https://supabase.com/dashboard.
# URL = Data API → API URL. KEY = API Keys → publishable key (sb_publishable_...).
# (Supabase retired the legacy "anon key" name; the publishable key is its replacement.
# Never put a sb_secret_* key here — secret keys are backend-only.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev-only: allow browsing the shell with no backend configured.
# Default off. When "true" and Supabase env is missing, routes are reachable
# and /login shows setup instructions instead of enforcing a session.
VITE_DEV_AUTH_BYPASS=false
